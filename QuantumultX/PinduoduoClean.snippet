# ! 拼多多底栏与横幅净化（Quantumult X 原生）
#!name=拼多多底栏与横幅净化
#!desc=保留首页、聊天、个人中心；移除已知首页活动横幅及个人中心横幅。需要 build 845+ 和 HTTPS 解密；关闭资源解析器。
# 不与其他修改 homepage/hub 或 philo/personal/hub 响应的拼多多规则同时启用。

^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub(?:\?|$) url jsonjq-response-body 'if (.result.bottom_tabs | type) == "array" then .result.bottom_tabs |= map(select(.link == "index.html" or .link == "chat_list.html" or .link == "personal.html")) else . end | if (.result.buffer_bottom_tabs | type) == "array" then .result.buffer_bottom_tabs |= map(select(.link == "index.html" or .link == "chat_list.html" or .link == "personal.html")) else . end | del(.result.dy_module.irregular_banner_dy)'
^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub(?:\?|$) url jsonjq-response-body 'del(.personal_banner)'

hostname = api.pinduoduo.com
